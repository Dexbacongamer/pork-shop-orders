\
    <!-- FIREBASE MODULE & REAL-TIME SYNC LOGIC -->\
    <script type="module">\
        import \{ initializeApp \} from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";\
        import \{ getDatabase, ref, push, set, onValue, update, remove \} from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";\
\
        // FIREBASE CONFIGURATION[cite: 1]\
        const firebaseConfig = \{\
            apiKey: "AIzaSyDc4oCclc0Ul_9jn-2XYRIwaL5Q6yBj5Cs",\
            authDomain: "pork-shop-orders.firebaseapp.com",\
            databaseURL: "https://pork-shop-orders-default-rtdb.asia-southeast1.firebasedatabase.app",\
            projectId: "pork-shop-orders",\
            storageBucket: "pork-shop-orders.firebasestorage.app",\
            messagingSenderId: "647120124610",\
            appId: "1:647120124610:web:3357f4ab085117da4bd95b"\
        \};\
\
        const app = initializeApp(firebaseConfig);\
        const db = getDatabase(app);\
\
        // AUDIO SFX\
        const audioTap = new Audio('https://assets.mixkit.co/active_storage/sfx/2568/2568-preview.mp3');\
        const audioSuccess = new Audio('https://assets.mixkit.co/active_storage/sfx/1435/1435-preview.mp3');\
        const audioDelete = new Audio('https://assets.mixkit.co/active_storage/sfx/2572/2572-preview.mp3');\
\
        function playSFX(audioObj) \{\
            if (audioObj) \{\
                audioObj.currentTime = 0;\
                audioObj.play().catch(e => console.log("Audio play deferred:", e));\
            \}\
        \}\
\
        window.state = \{\
            cust: \{ selectedMeatName: "", baseMeatPrice: 0, activeMeatPrice: 0, orderList: [] \},\
            calc: \{ selectedMeatName: "", baseMeatPrice: 0, activeMeatPrice: 0, orderList: [] \}\
        \};\
\
        window.addEventListener('DOMContentLoaded', () => \{\
            setTimeout(() => \{\
                document.getElementById('loadingScreen').classList.add('hidden');\
            \}, 2000);\
\
            listenToLiveOrders();\
            checkExistingCustomerOrder();\
            renderLogs();\
        \});\
\
        // VIEW & MODE SWITCHING\
        window.switchMode = function(mode) \{\
            playSFX(audioTap);\
            document.querySelectorAll('.view-section').forEach(v => v.classList.remove('active'));\
            document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));\
\
            if (mode === 'customer') \{\
                document.getElementById('customerView').classList.add('active');\
                document.getElementById('modeCustomerBtn').classList.add('active');\
            \} else \{\
                document.getElementById('sellerView').classList.add('active');\
                document.getElementById('modeSellerBtn').classList.add('active');\
            \}\
\
            window.scrollTo(\{ top: 0, behavior: 'smooth' \});\
        \};\
\
        window.switchSellerTab = function(tabId) \{\
            playSFX(audioTap);\
            document.querySelectorAll('.seller-tab-content').forEach(t => t.style.display = 'none');\
            document.querySelectorAll('.seller-nav-btn').forEach(b => b.classList.remove('active'));\
\
            document.getElementById(tabId).style.display = 'block';\
\
            if (tabId === 'liveOrdersTab') document.getElementById('navLiveOrdersBtn').classList.add('active');\
            if (tabId === 'calculatorTab') document.getElementById('navCalcBtn').classList.add('active');\
            if (tabId === 'logsTab') \{\
                document.getElementById('navLogsBtn').classList.add('active');\
                renderLogs();\
            \}\
        \};\
\
        // MEAT & WEIGHT SELECTION\
        window.selectMeat = function(name, defaultPrice, element, mode = 'cust') \{\
            playSFX(audioTap);\
            state[mode].selectedMeatName = name;\
            state[mode].baseMeatPrice = defaultPrice;\
            state[mode].activeMeatPrice = defaultPrice;\
\
            const container = element.parentElement;\
            container.querySelectorAll('.btn-meat').forEach(btn => btn.classList.remove('selected'));\
            element.classList.add('selected');\
        \};\
\
        window.handleBargainSelectChange = function(mode = 'cust') \{\
            const select = document.getElementById('bargainSelect' + (mode === 'cust' ? 'Cust' : 'Calc'));\
            const val = select.value;\
            if (val === 'default') \{\
                state[mode].activeMeatPrice = state[mode].baseMeatPrice;\
            \} else \{\
                state[mode].activeMeatPrice = parseFloat(val);\
            \}\
        \};\
\
        window.addWithWeightInKg = function(weightInKg, labelDisplay, mode = 'cust') \{\
            if (!state[mode].selectedMeatName) return;\
            const itemTotal = Math.round(state[mode].activeMeatPrice * weightInKg);\
            state[mode].orderList.push(\{\
                name: state[mode].selectedMeatName,\
                pricePerKg: state[mode].activeMeatPrice,\
                weightInKg,\
                labelDisplay,\
                itemTotal\
            \});\
            updateUI(mode);\
            playSFX(audioTap);\
        \};\
\
        window.addCustomWeight = function(mode = 'cust') \{\
            const suffix = mode === 'cust' ? 'Cust' : 'Calc';\
            const input = document.getElementById('customWeight' + suffix);\
            const unit = document.getElementById('weightUnit' + suffix).value;\
            let rawValue = parseFloat(input.value);\
\
            if (!state[mode].selectedMeatName || isNaN(rawValue) || rawValue <= 0) return;\
\
            let weightInKg = unit === 'kham' ? rawValue * 0.1 : rawValue;\
            let labelDisplay = unit === 'kham' ? rawValue + " \uc0\u6017 \u6070 \u6086 " : rawValue + "kg";\
\
            window.addWithWeightInKg(weightInKg, labelDisplay, mode);\
            input.value = "";\
        \};\
\
        window.removeItem = function(index, mode = 'cust') \{\
            playSFX(audioDelete);\
            state[mode].orderList.splice(index, 1);\
            updateUI(mode);\
        \};\
\
        window.resetOrder = function(mode = 'cust') \{\
            state[mode].orderList = [];\
            state[mode].selectedMeatName = "";\
            updateUI(mode);\
        \};\
\
        function updateUI(mode = 'cust') \{\
            const suffix = mode === 'cust' ? 'Cust' : 'Calc';\
            const listContainer = document.getElementById('itemList' + suffix);\
            const totalDisplay = document.getElementById('grandTotal' + suffix);\
\
            if (state[mode].orderList.length === 0) \{\
                listContainer.innerHTML = '<p style="color: #888; text-align: center; padding: 10px;">\uc0\u6040 \u6071 \u6035 \u6033 \u6070 \u6035 \u6091 \u6040 \u6070 \u6035 \u6033 \u6086 \u6035 \u6071 \u6025  (No items added)</p>';\
                totalDisplay.innerText = "0 \uc0\u6107 ";\
                return;\
            \}\
\
            let html = "";\
            let grandTotal = 0;\
\
            state[mode].orderList.forEach((item, index) => \{\
                grandTotal += item.itemTotal;\
                html += `\
                    <div class="ticket-item">\
                        <div>\
                            <strong>$\{item.name\}</strong><br>\
                            <small>$\{item.labelDisplay\} ($\{item.weightInKg\} kg) x $\{item.pricePerKg.toLocaleString()\} \uc0\u6107 </small>\
                        </div>\
                        <div style="display: flex; align-items: center; gap: 10px;">\
                            <strong>$\{item.itemTotal.toLocaleString()\} \uc0\u6107 </strong>\
                            <button class="btn-delete" onclick="removeItem($\{index\}, '$\{mode\}')">\uc0\u10005 </button>\
                        </div>\
                    </div>\
                `;\
            \});\
\
            listContainer.innerHTML = html;\
            totalDisplay.innerText = grandTotal.toLocaleString() + " \uc0\u6107 ";\
        \}\
\
        // FIREBASE SUBMISSION & LIVE RECEIPT (CUSTOMER)\
        window.submitCustomerOrder = function() \{\
            const name = document.getElementById('custName').value.trim();\
            const phone = document.getElementById('custPhone').value.trim();\
            const pickup = document.getElementById('custPickup').value.trim();\
\
            if (!name || state.cust.orderList.length === 0) \{\
                alert("\uc0\u6047 \u6076 \u6040 \u6036 \u6025 \u6098 \u6021 \u6076 \u6043 \u6024 \u6098 \u6040 \u6084 \u6087  \u6035 \u6071 \u6020 \u6023 \u6098 \u6042 \u6078 \u6047 \u6042 \u6078 \u6047 \u6040 \u6075 \u6017 \u6033 \u6086 \u6035 \u6071 \u6025 ! (Please enter customer name and select items)");\
                return;\
            \}\
\
            playSFX(audioSuccess);\
            const grandTotal = state.cust.orderList.reduce((sum, item) => sum + item.itemTotal, 0);\
\
            const orderRef = push(ref(db, 'orders'));\
            const orderData = \{\
                id: orderRef.key,\
                customerName: name,\
                customerPhone: phone || 'N/A',\
                pickupTime: pickup || ' ASAP',\
                items: state.cust.orderList,\
                grandTotal: grandTotal,\
                isPaid: false,\
                isDelivered: false,\
                timestamp: new Date().toLocaleTimeString('km-KH')\
            \};\
\
            set(orderRef, orderData).then(() => \{\
                localStorage.setItem('my_active_order_id', orderRef.key);\
                listenToMyCustomerOrder(orderRef.key);\
                window.resetOrder('cust');\
            \});\
        \};\
\
        function checkExistingCustomerOrder() \{\
            const activeId = localStorage.getItem('my_active_order_id');\
            if (activeId) \{\
                listenToMyCustomerOrder(activeId);\
            \}\
        \}\
\
        function listenToMyCustomerOrder(orderId) \{\
            const container = document.getElementById('customerReceiptContainer');\
            const content = document.getElementById('receiptContent');\
            container.style.display = 'block';\
\
            onValue(ref(db, 'orders/' + orderId), (snapshot) => \{\
                const order = snapshot.val();\
                if (!order) \{\
                    container.style.display = 'none';\
                    return;\
                \}\
\
                let itemsHtml = order.items.map(i => `<div class="log-item-row"><span>$\{i.name\} ($\{i.labelDisplay\})</span><span>$\{i.itemTotal.toLocaleString()\} \uc0\u6107 </span></div>`).join('');\
\
                content.innerHTML = `\
                    <p>\uc0\u55357 \u56420  <strong>$\{order.customerName\}</strong> ($\{order.customerPhone\})</p>\
                    <p>\uc0\u9200  <strong>\u6040 \u6089 \u6084 \u6020 \u6041 \u6016 :</strong> $\{order.pickupTime\}</p>\
                    <div style="margin: 10px 0;">$\{itemsHtml\}</div>\
                    <p class="log-total-row"><span>\uc0\u6047 \u6042 \u6075 \u6036 :</span><span>$\{order.grandTotal.toLocaleString()\} \u6107 </span></p>\
                    <div style="margin-top: 10px; display: flex; gap: 8px;">\
                        <span class="status-badge $\{order.isPaid ? 'badge-paid' : 'badge-pending'\}">\
                            $\{order.isPaid ? '\uc0\u9989  \u6036 \u6070 \u6035 \u6033 \u6076 \u6033 \u6070 \u6031 \u6091 \u6036 \u6098 \u6042 \u6070 \u6016 \u6091  (Paid)' : '\u10060  \u6040 \u6071 \u6035 \u6033 \u6070 \u6035 \u6091 \u6036 \u6020 \u6091 \u6036 \u6098 \u6042 \u6070 \u6016 \u6091  (Unpaid)'\}\
                        </span>\
                        <span class="status-badge $\{order.isDelivered ? 'badge-delivered' : 'badge-pending'\}">\
                            $\{order.isDelivered ? '\uc0\u55357 \u57077  \u6036 \u6070 \u6035 \u6036 \u6098 \u6042 \u6018 \u6043 \u6091 \u6033 \u6086 \u6035 \u6071 \u6025  (Delivered)' : '\u9203  \u6016 \u6086 \u6038 \u6075 \u6020 \u6042 \u6080 \u6036 \u6021 \u6086  (Preparing)'\}\
                        </span>\
                    </div>\
                `;\
            \});\
        \}\
\
        // FIREBASE LIVE ORDERS FEED (SELLER)\
        function listenToLiveOrders() \{\
            const feed = document.getElementById('firebaseOrdersFeed');\
\
            onValue(ref(db, 'orders'), (snapshot) => \{\
                const data = snapshot.val();\
                if (!data) \{\
                    feed.innerHTML = '<p style="color: #888; text-align: center; padding: 15px;">\uc0\u6040 \u6071 \u6035 \u6033 \u6070 \u6035 \u6091 \u6040 \u6070 \u6035 \u6016 \u6070 \u6042 \u6016 \u6075 \u6040 \u6098 \u6040 \u6089 \u6020 \u6091 \u6035 \u6085 \u6049 \u6078 \u6041 \u6033 \u6081  (No active orders)</p>';\
                    return;\
                \}\
\
                let html = "";\
                Object.keys(data).forEach((key) => \{\
                    const o = data[key];\
                    let itemsHtml = o.items.map(i => `<div class="log-item-row"><span>$\{i.name\} ($\{i.labelDisplay\})</span><span>$\{i.itemTotal.toLocaleString()\} \uc0\u6107 </span></div>`).join('');\
\
                    html += `\
                        <div class="order-card">\
                            <div class="order-header">\
                                <strong>\uc0\u55357 \u56420  $\{o.customerName\} ($\{o.customerPhone\})</strong>\
                                <small>\uc0\u55357 \u56658  $\{o.timestamp\}</small>\
                            </div>\
                            <p style="font-size: 13px; color: #666; margin-bottom: 6px;">\uc0\u9200  <strong>\u6040 \u6089 \u6084 \u6020 \u6041 \u6016 :</strong> $\{o.pickupTime\}</p>\
                            $\{itemsHtml\}\
                            <div class="log-total-row">\
                                <span>\uc0\u6047 \u6042 \u6075 \u6036 </span>\
                                <span>$\{o.grandTotal.toLocaleString()\} \uc0\u6107 </span>\
                            </div>\
                            <div class="toggle-actions">\
                                <button class="btn-check-action btn-pay $\{o.isPaid ? 'active' : ''\}" onclick="toggleOrderStatus('$\{key\}', 'isPaid', $\{!o.isPaid\})">\
                                    $\{o.isPaid ? '\uc0\u10003  \u6036 \u6070 \u6035 \u6036 \u6020 \u6091 \u6036 \u6098 \u6042 \u6070 \u6016 \u6091 ' : '\u6036 \u6020 \u6091 \u6036 \u6098 \u6042 \u6070 \u6016 \u6091 '\}\
                                </button>\
                                <button class="btn-check-action btn-deliver $\{o.isDelivered ? 'active' : ''\}" onclick="toggleOrderStatus('$\{key\}', 'isDelivered', $\{!o.isDelivered\})">\
                                    $\{o.isDelivered ? '\uc0\u10003  \u6036 \u6070 \u6035 \u6026 \u6073 \u6016 \u6023 \u6076 \u6035 ' : '\u6026 \u6073 \u6016 \u6023 \u6076 \u6035 '\}\
                                </button>\
                                <button class="btn-check-action" style="background: #2e7d32; color: white;" onclick="completeAndArchiveOrder('$\{key\}')">\
                                    \uc0\u9989  \u6036 \u6025 \u6098 \u6021 \u6036 \u6091 \
                                </button>\
                            </div>\
                        </div>\
                    `;\
                \});\
\
                feed.innerHTML = html;\
            \});\
        \}\
\
        window.toggleOrderStatus = function(orderId, field, newValue) \{\
            playSFX(audioTap);\
            update(ref(db, 'orders/' + orderId), \{ [field]: newValue \});\
        \};\
\
        window.completeAndArchiveOrder = function(orderId) \{\
            playSFX(audioSuccess);\
            onValue(ref(db, 'orders/' + orderId), (snapshot) => \{\
                const o = snapshot.val();\
                if (o) \{\
                    let logs = JSON.parse(localStorage.getItem('pork_sales_logs') || '[]');\
                    logs.unshift(\{\
                        id: Date.now(),\
                        timestamp: o.timestamp + ` ($\{o.customerName\})`,\
                        grandTotal: o.grandTotal,\
                        items: o.items\
                    \});\
                    localStorage.setItem('pork_sales_logs', JSON.stringify(logs));\
                    remove(ref(db, 'orders/' + orderId));\
                    renderLogs();\
                \}\
            \}, \{ onlyOnce: true \});\
        \};\
\
        window.saveWalkInSale = function() \{\
            if (state.calc.orderList.length === 0) return;\
            playSFX(audioSuccess);\
            const grandTotal = state.calc.orderList.reduce((sum, item) => sum + item.itemTotal, 0);\
\
            let logs = JSON.parse(localStorage.getItem('pork_sales_logs') || '[]');\
            logs.unshift(\{\
                id: Date.now(),\
                timestamp: new Date().toLocaleTimeString('km-KH') + " (Walk-in)",\
                grandTotal: grandTotal,\
                items: state.calc.orderList\
            \});\
            localStorage.setItem('pork_sales_logs', JSON.stringify(logs));\
\
            window.resetOrder('calc');\
            window.switchSellerTab('logsTab');\
        \};\
\
        function renderLogs() \{\
            const container = document.getElementById('logsContainer');\
            let logs = JSON.parse(localStorage.getItem('pork_sales_logs') || '[]');\
\
            let dailyTotal = 0;\
            if (logs.length === 0) \{\
                container.innerHTML = '<p style="color: #888; text-align: center; padding: 15px;">\uc0\u6040 \u6071 \u6035 \u6033 \u6070 \u6035 \u6091 \u6040 \u6070 \u6035 \u6036 \u6098 \u6042 \u6044 \u6031 \u6098 \u6031 \u6071 \u6043 \u6016 \u6091  (No saved logs)</p>';\
                document.getElementById('dailyTotalDisplay').innerText = "0 \uc0\u6107 ";\
                return;\
            \}\
\
            let html = "";\
            logs.forEach(log => \{\
                dailyTotal += log.grandTotal;\
                let itemsHtml = log.items.map(i => `<div class="log-item-row"><span>$\{i.name\} ($\{i.labelDisplay\})</span><span>$\{i.itemTotal.toLocaleString()\} \uc0\u6107 </span></div>`).join('');\
\
                html += `\
                    <div class="log-card">\
                        <div style="font-size: 13px; color: #555; margin-bottom: 4px;">\uc0\u55357 \u56658  $\{log.timestamp\}</div>\
                        $\{itemsHtml\}\
                        <div class="log-total-row">\
                            <span>\uc0\u6047 \u6042 \u6075 \u6036 </span>\
                            <span>$\{log.grandTotal.toLocaleString()\} \uc0\u6107 </span>\
                        </div>\
                    </div>\
                `;\
            \});\
\
            container.innerHTML = html;\
            document.getElementById('dailyTotalDisplay').innerText = dailyTotal.toLocaleString() + " \uc0\u6107 ";\
        \}\
    </script>\
</body>\
</html>}